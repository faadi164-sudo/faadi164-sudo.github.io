{"v":[[[["أَلَمْ","alam","Have not","کیا نہیں"],["تَرَ","tara","you seen","تم نے دیکھا"],["كَيْفَ","kayfa","how","کس طرح"],["فَعَلَ","faʿala","dealt","کیا"],["رَبُّكَ","rabbuka","your Lord","تیرے رب نے"],["بِأَصْحَابِ","bi-aṣḥābi","with (the) Companions","والوں کے ساتھ"],["الْفِيلِ","l-fīli","(of the) Elephant","ہاتھی (والوں کےساتھ)"]],"Have you not considered, [O Muḥammad], how your Lord dealt with the companions of the elephant?","کیا تم نے نہیں دیکھا کہ تمہارے پروردگار نے ہاتھی والوں کے ساتھ کیا کیا"],[[["أَلَمْ","alam","Did not","کیا نہیں"],["يَجْعَلْ","yajʿal","He make","کردیا"],["كَيْدَهُمْ","kaydahum","their plan","ان کی چال کو"],["فِي","fī","go","میں"],["تَضْلِيلٍ","taḍlīlin","astray","گمراہی میں (اکارت)"]],"Did He not make their plan into misguidance?","کیا ان کا داؤں غلط نہیں کیا؟ (گیا)"],[[["وَأَرْسَلَ","wa-arsala","And He sent","اور بھیجے"],["عَلَيْهِمْ","ʿalayhim","against them","ان پر"],["طَيْرًا","ṭayran","birds","پرندے"],["أَبَابِيلَ","abābīla","(in) flocks","جھنڈ کے جھنڈ"]],"And He sent against them birds in flocks,","اور ان پر جھلڑ کے جھلڑ جانور بھیجے"],[[["تَرْمِيهِم","tarmīhim","Striking them","پھینکتے تھے ان پر"],["بِحِجَارَةٍ","biḥijāratin","with stones","پتھر"],["مِّن","min","of","کے"],["سِجِّيلٍ","sijjīlin","baked clay","کنکر کی قسم کے"]],"Striking them with stones of hard clay,","جو ان پر کھنگر کی پتھریاں پھینکتے تھے"],[[["فَجَعَلَهُمْ","fajaʿalahum","Then He made them","تو کردیا ان کو"],["كَعَصْفٍ","kaʿaṣfin","like straw","بھوسے کی طرح"],["مَّأْكُولٍ","makūlin","eaten up","جو کھایا ہوا ہو"]],"And He made them like eaten straw.","تو ان کو ایسا کر دیا جیسے کھایا ہوا بھس"]]}